    "run.jl": {
      "name": "Datasets/Wholesale/Expected water values/2025/Week 52/Inputs/run.jl",
      "source_url": "https://emidatasets.blob.core.windows.net/publicdata/Datasets/Wholesale/Expected%20water%20values/2025/Week%2052/Inputs/run.jl",
      "content_length": "869",
      "text_preview": "using JADE, JuMP \n \n# Choose your solver \nusing Gurobi \nenv = Gurobi.Env() \noptimizer = optimizer_with_attributes(() -> Gurobi.Optimizer(env), \"OutputFlag\" => 0) \n \n## Set directory containing the Input / Output subdirectories \ncd(@__DIR__) \nENV[\"JADE_DIR\"] = dirname(dirname(@__DIR__)) \n \n## Modify these settings \ninputdir = basename(@__DIR__) \nrunfile = \"run\" \ntraining = true \nsimulation = true \n \n## Set up inputs for JADE models \nrundata = define_JADE_model(inputdir, run_file = runfile) \n \n## Create JADE model from the runfile data \nmodel = create_JADE_model(rundata, optimizer) \n \nif training \n    solve_options = define_JADE_solve_options(inputdir, run_file = runfile) \n    optimize_policy!(model, solve_options) \nend \n \nif simulation \n    sim_settings = define_JADE_simulation(inputdir, run_file = runfile) \n    results = simulate(model, sim_settings) \nend \n"
    },
